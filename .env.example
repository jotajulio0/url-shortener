POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=appdb
POSTGRES_PORT=5432

DATABASE_URL=postgres://app:app_password@localhost:5432/appdb?sslmode=disable

HTTP_ADDR=:8080
BASE_URL=http://localhost:8080

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTHCHECK_PERIOD=1m

MIGRATIONS_DIR=./migrations

LOG_FORMAT=development
